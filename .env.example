# AuraTechStores environment configuration example
# Copy these values into your deployment environment. Do not commit real secrets.

PORT=8086

# Optional database overrides
DB_URL=jdbc:h2:file:./data/aura
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=true
THYMELEAF_CACHE=false

# SMTP configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
